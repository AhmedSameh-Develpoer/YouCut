{
  "name": "youcut",
  "productName": "YouCut",
  "version": "0.4.8",
  "description": "A local-first workspace for turning long videos into vertical shorts.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test:recent": "node scripts/validate-project-recent.cjs",
    "test:batch": "node scripts/validate-batch-export.cjs",
    "test:keyframes": "node scripts/validate-framing-keyframes.cjs",
    "test:links": "node scripts/validate-link-import.cjs",
    "test:links:e2e": "node scripts/validate-link-import-e2e.cjs",
    "vendor:yt-dlp": "node scripts/fetch-yt-dlp.cjs",
    "package:win": "npm run build && npm run vendor:yt-dlp && electron-builder --win nsis",
    "package:win:portable": "npm run build && npm run vendor:yt-dlp && node scripts/package-portable.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.youcut.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/vendor/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
